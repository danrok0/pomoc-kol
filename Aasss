        .card:hover { transform: translateY(-5px); }
        .card h3 { color: #2980b9; margin-top: 0; }
        .badge { display: inline-block; background: #ecf0f1; padding: 5px 10px; border-radius: 20px; font-size: 12px; color: #7f8c8d; margin-bottom: 15px; font-weight: bold; }
        button { background-color: #27ae60; color: white; border: none; padding: 12px 20px; border-radius: 5px; font-weight: bold; cursor: pointer; width: 100%; transition: 0.3s; }
        button:hover { background-color: #2ecc71; }
        nav { text-align: center; margin-bottom: 30px; }
        nav a { text-decoration: none; color: #e67e22; font-weight: bold; font-size: 1.1em; }
    </style>
</head>
<body>
    <nav><a href="admin.html">⚙️ Przejdź do panelu administratora</a></nav>
    <h1>Dostępne Szkolenia w Systemie</h1>
    
    <div id="miejsce-na-kursy" class="grid">
        <p style="text-align:center; width: 100%;">Ładowanie kursów z bazy danych...</p>
    </div>

    <script>
        async function pokazKursy() {
            const res = await fetch('/api/kursy');
            const kursy = await res.json();
            const kontener = document.getElementById('miejsce-na-kursy');

            if(kursy.length === 0) {
                kontener.innerHTML = "<p style='text-align:center; width: 100%; color: #7f8c8d;'>Brak dostępnych kursów. Administrator musi je najpierw dodać.</p>";
                return;
            }

            kontener.innerHTML = kursy.map(kurs => `
                <div class="card">
                    <h3>${kurs.nazwa}</h3>
                    <div class="badge">${kurs.kategoria_id === 1 ? '💻 Programowanie' : '🌍 Języki Obce'}</div>
                    <button onclick="rezerwuj(${kurs.id})">✅ Zapisz się na wydarzenie</button>
                </div>
            `).join('');
        }

        async function rezerwuj(idKursu) {
            await fetch('/api/zapisy', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id_kursu: idKursu, id_uzytkownika: 2 }) // ID zalogowanego usera
            });
            alert("🎉 Super! Twoja rezerwacja została pomyślnie zapisana w bazie danych.");
        }

        pokazKursy();
    </script>
</body>
