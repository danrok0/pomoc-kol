const express = require('express'); 
const sqlite3 = require('sqlite3').verbose(); 
const path = require('path');

const app = express(); 

// To pozwala nam czytać pliki HTML i format JSON
app.use(express.static(__dirname)); 
app.use(express.json()); 

const db = new sqlite3.Database('./baza.db');

// Inicjalizacja bazy
db.serialize(() => {
    db.run("CREATE TABLE IF NOT EXISTS uzytkownicy (id INTEGER PRIMARY KEY, login TEXT, rola TEXT)");
    db.run("CREATE TABLE IF NOT EXISTS kategorie (id INTEGER PRIMARY KEY, nazwa TEXT)");
    db.run("CREATE TABLE IF NOT EXISTS tagi (id INTEGER PRIMARY KEY, nazwa TEXT)");
    db.run("CREATE TABLE IF NOT EXISTS kursy (id INTEGER PRIMARY KEY, nazwa TEXT, kategoria_id INTEGER)");
    db.run("CREATE TABLE IF NOT EXISTS kursy_tagi (kurs_id INTEGER, tag_id INTEGER)");
    db.run("CREATE TABLE IF NOT EXISTS zapisy (id INTEGER PRIMARY KEY, uzytkownik_id INTEGER, kurs_id INTEGER)");

    db.run("INSERT OR IGNORE INTO kategorie (id, nazwa) VALUES (1, 'Programowanie'), (2, 'Języki Obce')");
});

// --- API ---

app.get('/api/kursy', (req, res) => {
    db.all("SELECT * FROM kursy", [], (blad, wyniki) => {
        res.json(wyniki || []);
    });
});

app.post('/api/kursy', (req, res) => {
    const { nazwa, kategoria_id } = req.body;
    db.run("INSERT INTO kursy (nazwa, kategoria_id) VALUES (?, ?)", [nazwa, kategoria_id], function(blad) {
        res.json({ komunikat: "Zapisano", id: this.lastID });
    });
});

app.put('/api/kursy/:id', (req, res) => {
    const { nazwa } = req.body;
    db.run("UPDATE kursy SET nazwa = ? WHERE id = ?", [nazwa, req.params.id], () => {
        res.json({ komunikat: "Zaktualizowano" });
    });
});

app.delete('/api/kursy/:id', (req, res) => {
    db.run("DELETE FROM kursy WHERE id = ?", req.params.id, () => {
        res.json({ komunikat: "Usunięto" });
    });
});

app.post('/api/zapisy', (req, res) => {
    const { id_kursu, id_uzytkownika } = req.body;
    db.run("INSERT INTO zapisy (uzytkownik_id, kurs_id) VALUES (?, ?)", [id_uzytkownika, id_kursu], () => {
        res.json({ komunikat: "Zapisano rezerwację" });
    });
});

app.listen(3000, () => {
    console.log("Serwer działa na porcie 3000!");
});

