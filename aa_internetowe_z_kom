<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>Panel Administratora</title>
    <style>
        body { font-family: sans-serif; background: #ecf0f1; padding: 20px; max-width: 900px; margin: auto; }
        .card { background: white; padding: 20px; border-radius: 5px; margin-bottom: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 10px; border-bottom: 1px solid #ddd; text-align: left; }
        button { background: #e67e22; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 3px; margin-right: 5px; }
        .btn-add { background: #27ae60; padding: 10px 15px; }
        input, select { padding: 8px; margin-right: 10px; }
    </style>
</head>
<body>
    <div style="display: flex; justify-content: space-between;">
        <h2>Witaj, Administratorze</h2>
        <a href="index.html" style="color: red; text-decoration: none; font-weight: bold;">Wyloguj</a>
    </div>

    <div class="card">
        <h3>Dodaj Nowy Kurs</h3>
        <input type="text" id="nazwa" placeholder="Podaj nazwę kursu">
        <input type="number" id="cena" placeholder="Podaj cenę w PLN">
        <select id="kategoria">
            <option value="1">Programowanie</option>
            <option value="2">Biznes i Marketing</option>
        </select>
        <button class="btn-add" onclick="dodaj()">Zapisz do bazy</button>
    </div>

    <div class="card">
        <h3>Baza Kursów (Zarządzanie)</h3>
        <table id="tabela-kursow">
            <tr><th>Nazwa</th><th>Kategoria</th><th>Cena</th><th>Akcje</th></tr>
        </table>
    </div>

    <script>
        // --- ZABEZPIECZENIE STRONY ---
        // Pobieramy dane z pamięci przeglądarki. Jeśli kogoś tam nie ma lub ma rolę inną niż admin...
        const user = JSON.parse(localStorage.getItem('user'));
        if (!user || user.rola !== 'admin') {
            alert('Brak uprawnień do przeglądania tej strony!'); // Wyświetlamy błąd
            window.location.href = 'index.html'; // Wyrzucamy gościa z powrotem na stronę logowania
        }

        // --- READ: Funkcja pobierająca listę kursów z serwera i rysująca tabelkę ---
        async function laduj() {
            const res = await fetch('/api/kursy');
            const kursy = await res.json();
            const tab = document.getElementById('tabela-kursow');
            
            // Tworzymy nagłówki tabeli...
            tab.innerHTML = '<tr><th>Nazwa</th><th>Kategoria</th><th>Cena</th><th>Akcje</th></tr>' + 
                // ...a następnie dla każdego kursu doklejamy nowy wiersz (<tr>) z danymi
                kursy.map(k => `
                <tr>
                    <td>${k.nazwa}</td>
                    <td>${k.kategoria_nazwa}</td>
                    <td>${k.cena} PLN</td>
                    <td>
                        <button onclick="edytuj(${k.id}, '${k.nazwa}', ${k.cena})">Edytuj</button>
                        <button onclick="usun(${k.id})" style="background:#e74c3c;">Usuń</button>
                    </td>
                </tr>`).join('');
        }

        // --- CREATE: Wysyłanie nowego kursu na serwer ---
        async function dodaj() {
            // Zczytujemy to co admin wpisał w pola na ekranie
            const nazwa = document.getElementById('nazwa').value;
            const cena = document.getElementById('cena').value;
            const kategoria_id = document.getElementById('kategoria').value;
            
            // Wysyłamy prośbę POST z nowymi danymi (parsowanie ceny na liczbę zmiennoprzecinkową parseFloat)
            await fetch('/api/kursy', {
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({nazwa: nazwa, cena: parseFloat(cena), kategoria_id: kategoria_id})
            });
            // Czyścimy pole nazwy i odświeżamy tabelkę widoczną na ekranie
            document.getElementById('nazwa').value = ""; 
            document.getElementById('cena').value = "";
            laduj();
        }

        // --- UPDATE: Zmiana parametrów kursu (wyskakujące okienko prompt) ---
        async function edytuj(id, staraNazwa, staraCena) {
            // Pytamy admina o nową nazwę i cenę (w oknie wpisana jest domyślnie stara wartość)
            const nowaNazwa = prompt("Nowa nazwa kursu:", staraNazwa);
            const nowaCena = prompt("Nowa cena PLN:", staraCena);
            
            // Jeśli podał dane i nie kliknął "Anuluj"
            if(nowaNazwa && nowaCena) {
                // Wysyłamy prośbę PUT, która mówi "nadpisz kurs o tym konkretnym ID"
                await fetch('/api/kursy/' + id, {
                    method: 'PUT', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({nazwa: nowaNazwa, cena: parseFloat(nowaCena)})
                });
                laduj(); // Odświeżamy ekran po zapisaniu w bazie
            }
        }

        // --- DELETE: Skasowanie kursu z bazy ---
        async function usun(id) {
            // Używamy metody DELETE w żądaniu sieciowym, podając ID wybranego kursu na końcu adresu
            await fetch('/api/kursy/' + id, { method: 'DELETE' });
            laduj(); // Odświeżamy ekran po skasowaniu
        }

        // Przy pierwszym uruchomieniu strony wywołujemy od razu pobranie danych
        laduj();
    </script>
