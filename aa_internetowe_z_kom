//server.js

// ==========================================
// 1. IMPORTY NARZĘDZI (BIBLIOTEK)
// ==========================================
// Express to nasz główny framework do tworzenia serwera w Node.js
const express = require('express');
// Moduł do obsługi bazy danych SQLite (verbose pozwala na lepsze wyświetlanie błędów)
const sqlite3 = require('sqlite3').verbose();
// Narzędzie do radzenia sobie ze ścieżkami plików na dysku
const path = require('path');

// Tworzymy główny obiekt naszej aplikacji serwerowej
const app = express();

// ==========================================
// 2. KONFIGURACJA SERWERA
// ==========================================
// Ta linijka mówi serwerowi: "Jeśli ktoś wejdzie na Twój adres, pokaż mu pliki HTML, które leżą w tym samym folderze co Ty (__dirname)"
app.use(express.static(__dirname));
// Ta linijka mówi: "Będziemy wysyłać i odbierać dane w nowoczesnym formacie JSON. Naucz się go czytać."
app.use(express.json());

// Łączymy się z bazą danych (lub tworzymy plik platforma.db, jeśli jeszcze nie istnieje)
const db = new sqlite3.Database('./platforma.db');

// ==========================================
// 3. TWORZENIE STRUKTURY BAZY DANYCH
// ==========================================
// db.serialize upewnia się, że zapytania wykonają się po kolei, jedno po drugim
db.serialize(() => {
    // TABELA 1: Użytkownicy (Login, Hasło, Rola)
    db.run("CREATE TABLE IF NOT EXISTS uzytkownicy (id INTEGER PRIMARY KEY, login TEXT UNIQUE, haslo TEXT, rola TEXT)");
    
    // TABELA 2 i 3: Kategorie i Tagi (Proste tabele słownikowe)
    db.run("CREATE TABLE IF NOT EXISTS kategorie (id INTEGER PRIMARY KEY, nazwa TEXT)");
    db.run("CREATE TABLE IF NOT EXISTS tagi (id INTEGER PRIMARY KEY, nazwa TEXT)");
    
    // TABELA 4: Kursy (Główna tabela). Zawiera kategoria_id, co tworzy ZWIĄZEK 1:N z kategoriami
    db.run("CREATE TABLE IF NOT EXISTS kursy (id INTEGER PRIMARY KEY, nazwa TEXT, cena REAL, kategoria_id INTEGER, FOREIGN KEY(kategoria_id) REFERENCES kategorie(id))");
    
    // TABELA 5: Tabela pośrednia. Tworzy ZWIĄZEK N:M między kursami a tagami
    db.run("CREATE TABLE IF NOT EXISTS kursy_tagi (kurs_id INTEGER, tag_id INTEGER, FOREIGN KEY(kurs_id) REFERENCES kursy(id), FOREIGN KEY(tag_id) REFERENCES tagi(id))");
    
    // TABELA 6 i 7: Logika zamówień (ZWIĄZEK 1:N - Jedno zamówienie ma wiele pozycji)
    db.run("CREATE TABLE IF NOT EXISTS zamowienia (id INTEGER PRIMARY KEY, uzytkownik_id INTEGER, data TEXT, suma REAL, FOREIGN KEY(uzytkownik_id) REFERENCES uzytkownicy(id))");
    db.run("CREATE TABLE IF NOT EXISTS pozycje_zamowienia (id INTEGER PRIMARY KEY, zamowienie_id INTEGER, kurs_id INTEGER, FOREIGN KEY(zamowienie_id) REFERENCES zamowienia(id), FOREIGN KEY(kurs_id) REFERENCES kursy(id))");

    // WSTAWIANIE DANYCH STARTOWYCH (Opcja IGNORE zapobiega dublowaniu danych przy restarcie serwera)
    // Tworzymy konta do logowania: admin/admin123 oraz klient/klient123
    db.run("INSERT OR IGNORE INTO uzytkownicy (login, haslo, rola) VALUES ('admin', 'admin123', 'admin'), ('klient', 'klient123', 'user')");
    // Tworzymy dwie domyślne kategorie, żeby administrator miał z czego wybierać
    db.run("INSERT OR IGNORE INTO kategorie (id, nazwa) VALUES (1, 'Programowanie'), (2, 'Biznes i Marketing')");
});

// ==========================================
// 4. API - ENDPOINTY (Trasy, po których komunikuje się Frontend z Backendem)
// ==========================================

// --- ENDPOINT LOGOWANIA ---
app.post('/api/login', (req, res) => {
    // Wyciągamy login i hasło, które użytkownik wpisał w przeglądarce (req.body)
    const { login, haslo } = req.body;
    // Szukamy w bazie użytkownika, który ma dokładnie taki login i hasło (znaki zapytania chronią przed hakerami - SQL Injection)
    db.get("SELECT id, login, rola FROM uzytkownicy WHERE login = ? AND haslo = ?", [login, haslo], (err, row) => {
        if (row) {
            // Jeśli znaleziono, odsyłamy sukces i dane użytkownika
            res.json({ success: true, user: row }); 
        } else {
            // Jeśli nie, odsyłamy błąd 401 (Brak autoryzacji)
            res.status(401).json({ success: false, message: "Nieprawidłowy login lub hasło." });
        }
    });
});

// --- API DLA ADMINISTRATORA (CRUD: CREATE, READ, UPDATE, DELETE) ---

// READ (Pobieranie): Odsyła listę kursów z ładnie doklejoną nazwą kategorii
app.get('/api/kursy', (req, res) => {
    // Używamy JOIN, żeby zamiast "kategoria_id = 1" otrzymać słowo "Programowanie"
    const sql = `SELECT k.id, k.nazwa, k.cena, k.kategoria_id, kat.nazwa as kategoria_nazwa 
                 FROM kursy k JOIN kategorie kat ON k.kategoria_id = kat.id`;
    db.all(sql, [], (err, rows) => res.json(rows || []));
});

// CREATE (Dodawanie): Administrator dodaje nowy kurs
app.post('/api/kursy', (req, res) => {
    const { nazwa, cena, kategoria_id } = req.body; // Pobieramy dane z formularza
    db.run("INSERT INTO kursy (nazwa, cena, kategoria_id) VALUES (?, ?, ?)", [nazwa, cena, kategoria_id], function(err) {
        if (err) return res.status(500).json({ error: err.message });
        res.json({ komunikat: "Dodano kurs" }); // Informujemy przeglądarkę, że się udało
    });
});

// UPDATE (Edycja): Zmiana nazwy lub ceny
app.put('/api/kursy/:id', (req, res) => {
    const { nazwa, cena } = req.body;
    // req.params.id wyciąga ID kursu końcówki adresu (np. z /api/kursy/5 wyciągnie 5)
    db.run("UPDATE kursy SET nazwa = ?, cena = ? WHERE id = ?", [nazwa, cena, req.params.id], () => {
        res.json({ komunikat: "Zaktualizowano kurs" });
    });
});

// DELETE (Usuwanie): Skasowanie kursu z bazy
app.delete('/api/kursy/:id', (req, res) => {
    // Zanim usuniemy kurs, musimy usunąć go z historii zamówień, żeby baza się nie wysypała (integralność relacji)
    db.run("DELETE FROM pozycje_zamowienia WHERE kurs_id = ?", req.params.id); 
    // Następnie kasujemy sam kurs
    db.run("DELETE FROM kursy WHERE id = ?", req.params.id, () => {
        res.json({ komunikat: "Usunięto kurs" });
    });
});

// --- API DLA UŻYTKOWNIKA (AKCJA NIETRYWIALNA - KOSZYK I ZAMÓWIENIE) ---

app.post('/api/zamowienia', (req, res) => {
    // Odbieramy całą paczkę z przeglądarki: kto kupuje, tablicę z koszykiem i łączną sumę
    const { uzytkownik_id, koszyk, suma } = req.body;
    const dataZamowienia = new Date().toISOString(); // Generujemy obecną datę i czas
    
    // KROK 1: Tworzymy "Nagłówek paragonu" (Ogólne dane zamówienia)
    db.run("INSERT INTO zamowienia (uzytkownik_id, data, suma) VALUES (?, ?, ?)", [uzytkownik_id, dataZamowienia, suma], function(err) {
        if (err) return res.status(500).json({ error: err.message });
        
        // this.lastID to numer (ID) zamówienia, które przed chwilą stworzyliśmy
        const zamowienieId = this.lastID; 
        
        // KROK 2: Przygotowujemy maszynkę do wrzucania wielu pozycji do bazy
        const stmt = db.prepare("INSERT INTO pozycje_zamowienia (zamowienie_id, kurs_id) VALUES (?, ?)");
        
        // Przechodzimy pętlą przez każdy kurs w koszyku i przypisujemy go do tego zamówienia
        koszyk.forEach(item => {
            stmt.run([zamowienieId, item.id]);
        });
        stmt.finalize(); // Zamykamy maszynkę

        // Gdy wszystko się wykona, informujemy przeglądarkę o wielkim sukcesie
        res.json({ success: true, message: "Zamówienie złożone pomyślnie!" });
    });
});

// ==========================================
// 5. URUCHOMIENIE SERWERA
// ==========================================
app.listen(3000, () => {
    console.log("Serwer działa na porcie 3000! Nasłuchiwanie włączone.");
});

