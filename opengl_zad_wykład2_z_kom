// 6. GŁÓWNA FUNKCJA PROGRAMU (MAIN)
// ==============================================================================================
int main() {
    // ------------------------------------------------------------------------------------------
    // A) Inicjalizacja GLFW i konfiguracja wersji OpenGL
    // ------------------------------------------------------------------------------------------
    if (!glfwInit()) {
        std::cerr << "Blad krytyczny: Nie udalo sie zainicjalizowac GLFW!" << std::endl;
        return -1;
    }

    // Ustawiamy "podpowiedzi" (hints) dla GLFW określające wymagany profil OpenGL:
    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);                 // Chcemy wersję główną 3
    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);                 // Chcemy podwersję 3 (czyli razem OpenGL 3.3)
    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE); // Profil CORE: bez przestarzałych funkcji jak glBegin/glEnd

    // Tworzymy okno o szerokości 800 pikseli, wysokości 600 pikseli i tytule "Zadanie OpenGL - 3 Sceny"
    GLFWwindow* window = glfwCreateWindow(800, 600, "Zadanie OpenGL - 3 Sceny", NULL, NULL);
    if (!window) {
        std::cerr << "Nie udalo sie utworzyc okna GLFW!" << std::endl;
        glfwTerminate(); // Zwalnia zasoby GLFW przed wyjściem
        return -1;
    }

    // Aktywujemy kontekst OpenGL powiązany z utworzonym oknem w bieżącym wątku procesora:
    glfwMakeContextCurrent(window);

    // Rejestrujemy funkcje zwrotne (callbacki):
    glfwSetFramebufferSizeCallback(window, framebuffer_size_callback); // Przy zmianie rozmiaru okna
    glfwSetKeyCallback(window, key_callback);                         // Przy zdarzeniach klawiatury

    // ------------------------------------------------------------------------------------------
    // B) Inicjalizacja biblioteki GLAD
    // ------------------------------------------------------------------------------------------
    // GLAD dynamicznie pobiera od sterownika karty graficznej adresy wszystkich funkcji OpenGL
    // (np. glGenBuffers, glDrawArrays). Bez tej linijki każda funkcja OpenGL zakończyłaby się crash'em!
    if (!gladLoadGLLoader((GLADloadproc)glfwGetProcAddress)) {
        std::cerr << "Nie udalo sie zaladowac biblioteki GLAD!" << std::endl;
        glfwDestroyWindow(window);
        glfwTerminate();
        return -1;
    }

    // Inicjalizacja generatora liczb losowych aktualnym czasem (aby każde uruchomienie dawało inne kwadraty)
    srand(static_cast<unsigned int>(time(NULL)));

    // ------------------------------------------------------------------------------------------
    // C) Generowanie geometrii kwadratów na procesorze CPU (w pamięci RAM)
    // ------------------------------------------------------------------------------------------
    // W OpenGL nie istnieje podstawowy prymityw "GL_QUADS" w profilu Core.
    // Każdy kwadrat musi zostać zbudowany z 2 trójkątów = 6 wierzchołków.
    std::vector<float> squaresPositions; // Współrzędne (x, y) wierzchołków dla obu scen
    std::vector<float> colorsFlat;       // Kolory (r, g, b) dla Sceny 1 (jednolite)
    std::vector<float> colorsGradient;   // Kolory (r, g, b) dla Sceny 2 (różne na każdy wierzchołek)

    for (int i = 0; i < N; ++i) {
        // Losujemy położenie lewego dolnego rogu kwadratu w przestrzeni znormalizowanej [-1.0, 1.0]:
        float x = randomFloat(-0.95f, 0.8f);
        float y = randomFloat(-0.95f, 0.8f);
        // Losujemy rozmiar kwadratu:
        float size = randomFloat(0.06f, 0.16f);

        // Definicja 2 trójkątów tworzących 1 kwadrat:
        // Trójkąt A: (lewy-dół), (prawy-dół), (prawy-góra)
        // Trójkąt B: (lewy-dół), (prawy-góra), (lewy-góra)
        float p[] = {
            x,        y,          // Wierzchołek 1
            x + size, y,          // Wierzchołek 2
            x + size, y + size,   // Wierzchołek 3

            x,        y,          // Wierzchołek 4
            x + size, y + size,   // Wierzchołek 5
            x,        y + size    // Wierzchołek 6
        };
        // Dopisujemy 12 współrzędnych (6 wierzchołków * 2 floaty) do wektora:
        squaresPositions.insert(squaresPositions.end(), p, p + 12);

        // --- DANE DLA SCENY 1 (Kolor płaski / Flat): ---
        // Losujemy jeden kolor (r, g, b) dla całego kwadratu:
        float r = randomFloat(0.0f, 1.0f);
        float g = randomFloat(0.0f, 1.0f);
        float b = randomFloat(0.0f, 1.0f);
        // I przypisujemy ten SAM kolor wszystkim 6 wierzchołkom:
        for (int j = 0; j < 6; ++j) {
            colorsFlat.push_back(r);
            colorsFlat.push_back(g);
            colorsFlat.push_back(b);
        }

        // --- DANE DLA SCENY 2 (Kolor gradientowy): ---
        // Zgodnie z poleceniem: chcemy gradient na kwadratach.
        // Losujemy ODMIENNY kolor dla każdego z 6 wierzchołków:
        for (int j = 0; j < 6; ++j) {
            colorsGradient.push_back(randomFloat(0.0f, 1.0f));
            colorsGradient.push_back(randomFloat(0.0f, 1.0f));
            colorsGradient.push_back(randomFloat(0.0f, 1.0f));
        }
    }

    // ------------------------------------------------------------------------------------------
    // D) Kompilacja programów shaderów
    // ------------------------------------------------------------------------------------------
    // shader12: potok dla Sceny 1 i Sceny 2 (kolory pobierane z bufora atrybutów GPU)
    unsigned int shader12 = compileShader(vertexShaderSource12, fragmentShaderSource12);

    // shader3: potok dla Sceny 3 (domek z Blendera - kolory generowane przez Fragment Shader)
    unsigned int shader3  = compileShader(vertexShaderSource3,  fragmentShaderSource3);

    // Pobieramy "adresy" (lokacje) zmiennych uniform w shaderze sceny 3:
    // Dzięki temu będziemy mogli w pętli renderowania przesyłać do nich wartości houseOffsetX i houseOffsetY.
    int locOffsetX = glGetUniformLocation(shader3, "offsetX");
    int locOffsetY = glGetUniformLocation(shader3, "offsetY");

    // ------------------------------------------------------------------------------------------
    // E) Tworzenie struktur danych na GPU (VBO i VAO)
    // ------------------------------------------------------------------------------------------
    // TEORIA:
    // - VBO (Vertex Buffer Object): to tablica czystych bajtów w szybkiej pamięci VRAM karty graficznej.
    // - VAO (Vertex Array Object): to obiekt przechowujący stan/konfigurację. Zapamiętuje:
    //   1. Który bufor VBO jest podpięty.
    //   2. Jak interpretować dane w buforze (gdzie jest pozycja, gdzie kolor, jaki typ danych).
    //   Dzięki VAO przy rysowaniu wystarczy jedna komenda: glBindVertexArray(VAO), zamiast konfigurować wszystko od nowa!

    unsigned int VBO_pos;   // Bufor pozycji kwadratów (współdzielony między Sceną 1 a Sceną 2!)
    unsigned int VBO_col1;  // Bufor kolorów płaskich dla Sceny 1
    unsigned int VBO_col2;  // Bufor kolorów gradientowych dla Sceny 2
    unsigned int VBO_house; // Bufor współrzędnych domku dla Sceny 3

    // Generujemy 4 unikalne identyfikatory buforów na GPU:
    glGenBuffers(1, &VBO_pos);
    glGenBuffers(1, &VBO_col1);
    glGenBuffers(1, &VBO_col2);
    glGenBuffers(1, &VBO_house);

    // Deklarujemy 3 obiekty VAO (po jednym dla każdej sceny):
    unsigned int VAO1, VAO2, VAO3;

    // =========================================================================
    // KONFIGURACJA VAO 1 (SCENA 1 - KWADRATY PŁASKIE)
    // =========================================================================
    glGenVertexArrays(1, &VAO1);
    glBindVertexArray(VAO1); // Rozpoczynamy nagrywanie konfiguracji dla VAO1

    // 1. Podpinamy i ładujemy bufor pozycji kwadratów do pamięci VRAM:
    glBindBuffer(GL_ARRAY_BUFFER, VBO_pos);
    // glBufferData kopiuje dane z pamięci RAM (squaresPositions.data()) do pamięci VRAM karty graficznej:
    // GL_STATIC_DRAW oznacza: dane wyślemy raz, a będziemy z nich rysować wielokrotnie bez modyfikacji.
    glBufferData(GL_ARRAY_BUFFER, squaresPositions.size() * sizeof(float), squaresPositions.data(), GL_STATIC_DRAW);

    // glVertexAttribPointer uczy OpenGL jak czytać te dane w Vertex Shaderze:
    // - indeks 0: odpowiada layout (location = 0) in vec2 aPos w shaderze
    // - 2: każdy wierzchołek ma 2 składowe (x oraz y)
    // - GL_FLOAT: dane to liczby typu float (4 bajty każda)
    // - GL_FALSE: nie normalizujemy liczb
    // - 2 * sizeof(float): krok (stride) do następnego wierzchołka wynosi 8 bajtów
    // - (void*)0: przesunięcie (offset) od początku bufora wynosi 0
    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float), (void*)0);
    glEnableVertexAttribArray(0); // Aktywujemy atrybut o indeksie 0

    // 2. Podpinamy i ładujemy bufor kolorów płaskich:
    glBindBuffer(GL_ARRAY_BUFFER, VBO_col1);
    glBufferData(GL_ARRAY_BUFFER, colorsFlat.size() * sizeof(float), colorsFlat.data(), GL_STATIC_DRAW);
    // Indeks 1 odpowiada layout (location = 1) in vec3 aColor w shaderze:
    // 3 składowe (r, g, b), krok wynosi 3 * sizeof(float) = 12 bajtów
    glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 3 * sizeof(float), (void*)0);
    glEnableVertexAttribArray(1); // Aktywujemy atrybut o indeksie 1

    // =========================================================================
    // KONFIGURACJA VAO 2 (SCENA 2 - KWADRATY Z GRADIENTEM)
    // =========================================================================
    // ZGODNIE Z POLECENIEM ZADANIA:
    // "stwórz VAO z buforem na dane współrzędne wierzchołków z poprzedniej sceny oraz drugi bufor (nowy) z kolorami"
    glGenVertexArrays(1, &VAO2);
    glBindVertexArray(VAO2); // Rozpoczynamy konfigurację VAO2

    // Używamy TEGO SAMEGO bufora VBO_pos co w scenie 1! Nie kopiujemy współrzędnych drugi raz do VRAM:
    glBindBuffer(GL_ARRAY_BUFFER, VBO_pos);
    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float), (void*)0);
    glEnableVertexAttribArray(0);

    // Ale podpinamy NOWY bufor z kolorami gradientowymi (VBO_col2):
    glBindBuffer(GL_ARRAY_BUFFER, VBO_col2);
    glBufferData(GL_ARRAY_BUFFER, colorsGradient.size() * sizeof(float), colorsGradient.data(), GL_STATIC_DRAW);
    glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 3 * sizeof(float), (void*)0);
    glEnableVertexAttribArray(1);

    // =========================================================================
    // KONFIGURACJA VAO 3 (SCENA 3 - DOMEK Z BLENDERA)
    // =========================================================================
    // ZGODNIE Z ZADANIEM 3:
    // "Dołącz plik house.h do swojego programu i potraktuj tak samo jak trójkąty w zadaniach z wykładu".
    glGenVertexArrays(1, &VAO3);
    glBindVertexArray(VAO3);

    // Podpinamy bufor dla domku i kopiujemy do niego tablicę Mesh_Vertices z pliku house.h:
    glBindBuffer(GL_ARRAY_BUFFER, VBO_house);
    glBufferData(GL_ARRAY_BUFFER, sizeof(Mesh_Vertices), Mesh_Vertices, GL_STATIC_DRAW);
    // Model domku w 2D składa się z par współrzędnych (x, y), więc konfigurujemy atrybut 0:
    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float), (void*)0);
    glEnableVertexAttribArray(0);
    // Zauważ: dla domku NIE tworzymy bufora kolorów!
    // Zgodnie z poleceniem: "W tej scenie, przeciwnie do poprzednich, to shader ma decydować o kolorach".

    // ------------------------------------------------------------------------------------------
    // F) Architektura scen pozwalająca na łatwą rozbudowę
    // ------------------------------------------------------------------------------------------
    // ZGODNIE Z POLECENIEM: "Popracuj na koniec nad kodem tak, aby łatwo dodawało się nowe sceny."
    //
    // Tradycyjne podejście ze switchem w pętli głównej jest nieoptymalne i trudne w utrzymaniu.
    // Zastosowaliśmy profesjonalny wzorzec: wektor funkcji (lambd) std::vector<std::function<void()>>.
    // Każda scena jest całkowicie niezależną funkcją rysującą.
    // Aby dodać Scenę 4, wystarczy po prostu dopisać kolejną lambdę do listy `sceneList`!
    // Cały system (liczba scen, modulo przy spacji) zaktualizuje się automatycznie.
    std::vector<std::function<void()>> sceneList = {
        // --- SCENA 1: Kwadraty jednolite ---
        [&]() {
            glUseProgram(shader12);            // Aktywujemy program cieniujący 1&2
            glBindVertexArray(VAO1);           // Podpinamy VAO z buforem pozycji i buforem kolorów płaskich
            // glDrawArrays rysuje prymitywy z podpiętego VAO:
            // - GL_TRIANGLES: co 3 wierzchołki tworzą jeden trójkąt
            // - 0: zaczynamy od wierzchołka o indeksie 0
            // - N * 6: liczba wierzchołków do narysowania (100 kwadratów * 6 wierzchołków = 600)
            glDrawArrays(GL_TRIANGLES, 0, N * 6);
        },

        // --- SCENA 2: Kwadraty z gradientem ---
        [&]() {
            glUseProgram(shader12);            // Używamy tego samego potoku co w scenie 1!
            glBindVertexArray(VAO2);           // Ale podpinamy VAO2 z nowym buforem kolorów gradientowych
            glDrawArrays(GL_TRIANGLES, 0, N * 6);
        },

        // --- SCENA 3: Domek z Blendera sterowany WSAD ---
        [&]() {
            glUseProgram(shader3);             // Aktywujemy dedykowany program dla domku
            // Przesyłamy bieżące wartości przesunięcia do zmiennych uniform na karcie graficznej:
            glUniform1f(locOffsetX, houseOffsetX);
            glUniform1f(locOffsetY, houseOffsetY);
            glBindVertexArray(VAO3);           // Podpinamy VAO z wierzchołkami z house.h
            // Rysujemy NUMBER_OF_VERTICES (27 wierzchołków = 9 trójkątów)
            glDrawArrays(GL_TRIANGLES, 0, NUMBER_OF_VERTICES);
        }
    };

    // Automatycznie pobieramy liczbę scen z wektora (dzięki temu spacja zawsze działa poprawnie):
    totalScenes = static_cast<int>(sceneList.size());

    // Informacje w konsoli dla użytkownika:
    std::cout << "==================================================\n";
    std::cout << "Program uruchomiony pomyslnie!\n";
    std::cout << "Klawisz [SPACJA]  - Przelaczanie scen rotacyjnie\n";
    std::cout << "Klawisze [WSAD]   - Przesuwanie domku w Scenie 3\n";
    std::cout << "Klawisz [ESC]     - Wyjscie z programu\n";
    std::cout << "==================================================" << std::endl;

    // ------------------------------------------------------------------------------------------
    // G) Główna pętla programu (Game / Render Loop)
    // ------------------------------------------------------------------------------------------
    // Pętla wykonuje się nieprzerwanie w każdej klatce (np. 60 lub 144 razy na sekundę),
    // dopóki użytkownik nie zamknie okna krzyżykiem lub klawiszem ESC.
    while (!glfwWindowShouldClose(window)) {
        // 1. Ustawiamy kolor tła (RGBA) przy czyszczeniu ekranu:
        // Ciemnoszary z lekkim odcieniem granatu (0.12, 0.12, 0.14) daje świetny kontrast dla kolorów
        glClearColor(0.12f, 0.12f, 0.14f, 1.0f);
        // Czyścimy bufor koloru (Color Buffer) przed rysowaniem nowej klatki:
        glClear(GL_COLOR_BUFFER_BIT);

        // 2. Wywołujemy funkcję renderującą dla aktualnie wybranej sceny:
        sceneList[currentScene]();

        // 3. Podwójne buforowanie (Double Buffering):
        // Karta graficzna rysuje nową klatkę w niewidocznym buforze tylnym (Back Buffer).
        // glfwSwapBuffers zamienia bufor tylny z przednim (widocznym na monitorze).
        // Zapobiega to efektowi migotania i rozrywania obrazu (tzw. screen tearing).
        glfwSwapBuffers(window);

        // 4. Obsługa zdarzeń systemu operacyjnego:
        // Sprawdza czy użytkownik wcisnął klawisz, kliknął myszą lub zmienił rozmiar okna,
        // i wywołuje odpowiednie zarejestrowane callbacki (np. key_callback).
        glfwPollEvents();
    }

    // ------------------------------------------------------------------------------------------
    // H) Sprzątanie pamięci i zakończenie programu
    // ------------------------------------------------------------------------------------------
    // Po wyjściu z pętli zwalniamy wszystkie zaalokowane zasoby na karcie graficznej GPU:
    glDeleteVertexArrays(1, &VAO1);
    glDeleteVertexArrays(1, &VAO2);
    glDeleteVertexArrays(1, &VAO3);
    glDeleteBuffers(1, &VBO_pos);
    glDeleteBuffers(1, &VBO_col1);
    glDeleteBuffers(1, &VBO_col2);
    glDeleteBuffers(1, &VBO_house);
    glDeleteProgram(shader12);
    glDeleteProgram(shader3);

    // Zamykamy okno i czyścimy bibliotekę GLFW:
    glfwDestroyWindow(window);
    glfwTerminate();

    return 0; // Pomyślne zakończenie działania aplikacji
}
