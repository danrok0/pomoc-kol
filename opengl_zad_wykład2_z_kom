// Funkcja odpowiedzialna za kompilację kodu GLSL na GPU oraz zlinkowanie w program shaderów
unsigned int compileShader(const char* vSource, const char* fSource) {
    int success;         // Zmienna flagowa do sprawdzania czy operacja powiodła się (GL_TRUE / GL_FALSE)
    char infoLog[512];   // Bufor tekstowy na raport o ewentualnych błędach składni w kodzie shadera

    // 1. Utworzenie pustego obiektu Vertex Shadera na GPU
    unsigned int vertexShader = glCreateShader(GL_VERTEX_SHADER);
    // Przekazanie kodu źródłowego shadera:
    // (uchwyt shadera, liczba ciągów znaków = 1, wskaźnik na kod źródłowy, NULL = ciąg zakończony zerem)
    glShaderSource(vertexShader, 1, &vSource, NULL);
    // Kompilacja kodu GLSL przez sterownik karty graficznej:
    glCompileShader(vertexShader);
    // Sprawdzenie czy kompilacja Vertex Shadera zakończyła się sukcesem:
    glGetShaderiv(vertexShader, GL_COMPILE_STATUS, &success);
    if (!success) {
        glGetShaderInfoLog(vertexShader, 512, NULL, infoLog);
        std::cerr << "Blad kompilacji Vertex Shadera:\n" << infoLog << std::endl;
    }

    // 2. Utworzenie pustego obiektu Fragment Shadera na GPU
    unsigned int fragmentShader = glCreateShader(GL_FRAGMENT_SHADER);
    glShaderSource(fragmentShader, 1, &fSource, NULL);
    glCompileShader(fragmentShader);
    // Sprawdzenie błędów kompilacji Fragment Shadera:
    glGetShaderiv(fragmentShader, GL_COMPILE_STATUS, &success);
    if (!success) {
        glGetShaderInfoLog(fragmentShader, 512, NULL, infoLog);
        std::cerr << "Blad kompilacji Fragment Shadera:\n" << infoLog << std::endl;
    }

    // 3. Utworzenie tzw. Programu Shaderów (Shader Program)
    // Program to zlinkowana całość: wyjścia z Vertex Shadera łączą się z wejściami Fragment Shadera.
    unsigned int shaderProgram = glCreateProgram();
    glAttachShader(shaderProgram, vertexShader);   // Dołączenie skompilowanego Vertex Shadera
    glAttachShader(shaderProgram, fragmentShader); // Dołączenie skompilowanego Fragment Shadera
    glLinkProgram(shaderProgram);                  // Linkowanie programu
    // Sprawdzenie poprawności linkowania:
    glGetProgramiv(shaderProgram, GL_LINK_STATUS, &success);
    if (!success) {
        glGetProgramInfoLog(shaderProgram, 512, NULL, infoLog);
        std::cerr << "Blad linkowania Programu Shadera:\n" << infoLog << std::endl;
    }

    // Po poprawnym zlinkowaniu w program wykonywalny GPU, pojedyncze obiekty shaderów
    // nie są już potrzebne w pamięci i można je bezpiecznie skasować:
    glDeleteShader(vertexShader);
    glDeleteShader(fragmentShader);

    return shaderProgram; // Zwracamy identyfikator (uchwyt) gotowego programu cieniującego
}

// Callback wywoływany przez GLFW za każdym razem, gdy użytkownik zmieni rozmiar okna myszką:
void framebuffer_size_callback(GLFWwindow* window, int width, int height) {
    // glViewport definiuje prostokąt w oknie, na którym OpenGL ma rysować.
    // (początek x = 0, początek y = 0, szerokość w pikselach, wysokość w pikselach).
    // Dzięki temu obraz nie rozciąga się nieprawidłowo po zmianie okna.
    glViewport(0, 0, width, height);
}

// Callback obsługujący zdarzenia z klawiatury:
// - window: wskaźnik na okno, które wygenerowało zdarzenie
// - key: kod wciśniętego klawisza (np. GLFW_KEY_SPACE, GLFW_KEY_W)
// - scancode: sprzętowy kod klawisza zależny od systemu
// - action: co się stało (GLFW_PRESS = wciśnięcie, GLFW_RELEASE = puszczenie, GLFW_REPEAT = trzymanie klawisza)
// - mods: wciśnięte modyfikatory (np. Shift, Alt, Ctrl)
void key_callback(GLFWwindow* window, int key, int scancode, int action, int mods) {
    // Wyjście z programu po naciśnięciu ESC:
    if (action == GLFW_PRESS && key == GLFW_KEY_ESCAPE) {
        glfwSetWindowShouldClose(window, true); // Oznacza okno jako "do zamknięcia"
    }

    // Przełączanie scen klawiszem SPACJA:
    // Używamy arytmetyki modulo: (currentScene + 1) % totalScenes
    // Dla 3 scen daje to sekwencję: 0 -> 1 -> 2 -> 0 -> 1 -> ... (pełna rotacja zgodnie z treścią zadania!)
    if (action == GLFW_PRESS && key == GLFW_KEY_SPACE) {
        currentScene = (currentScene + 1) % totalScenes;
        std::cout << "Przelaczono na Scene " << (currentScene + 1) << std::endl;
    }

    // Sterowanie domkiem w Scenie 3 za pomocą klawiszy WSAD lub strzałek:
    // Obsługujemy zarówno pojedyncze wciśnięcie (GLFW_PRESS), jak i płynne trzymanie klawisza (GLFW_REPEAT).
    float speed = 0.05f; // Krok przesunięcia przy każdym naciśnięciu
    if ((key == GLFW_KEY_W || key == GLFW_KEY_UP) && (action == GLFW_PRESS || action == GLFW_REPEAT)) {
        houseOffsetY += speed; // Ruch w górę
    }
    if ((key == GLFW_KEY_S || key == GLFW_KEY_DOWN) && (action == GLFW_PRESS || action == GLFW_REPEAT)) {
        houseOffsetY -= speed; // Ruch w dół
    }
    if ((key == GLFW_KEY_A || key == GLFW_KEY_LEFT) && (action == GLFW_PRESS || action == GLFW_REPEAT)) {
        houseOffsetX -= speed; // Ruch w lewo
    }
    if ((key == GLFW_KEY_D || key == GLFW_KEY_RIGHT) && (action == GLFW_PRESS || action == GLFW_REPEAT)) {
        houseOffsetX += speed; // Ruch w prawo
    }
}

// Funkcja losująca liczbę zmiennoprzecinkową (float) z przedziału [min, max]:
float randomFloat(float min, float max) {
    // rand() zwraca liczbę całkowitą od 0 do RAND_MAX.
    // Dzieląc przez RAND_MAX otrzymujemy ułamek z zakresu [0.0, 1.0],
    // a następnie skalujemy go do żądanego przedziału [min, max].
    return min + static_cast<float>(rand()) / (static_cast<float>(RAND_MAX / (max - min)));
}

