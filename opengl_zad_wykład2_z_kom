// ==============================================================================================
// 4. SHADERY (PROGRAMY URUCHAMIANE BEZPOŚREDNIO NA KORZE GRAFICZNEJ GPU)
// ==============================================================================================
// W nowoczesnym OpenGL (Core Profile od wersji 3.3 wzwyż) potok graficzny jest programowalny.
// Aby cokolwiek narysować, MUSIMY dostarczyć co najmniej dwa shadery napisane w języku GLSL:
//
// 1. VERTEX SHADER (Shader Wierzchołków):
//    - Uruchamia się dla KAŻDEGO wierzchołka osobno (np. dla 100 kwadratów = 600 razy na klatkę).
//    - Jego głównym zadaniem jest obliczenie ostatecznej pozycji wierzchołka w przestrzeni ekranu
//      i zapisanie jej do wbudowanej zmiennej `gl_Position`.
//
// 2. RASTERYZATOR (Układ sprzętowy GPU między shaderami):
//    - Łączy wierzchołki w trójkąty, tnie je i zamienia na siatkę pikseli (tzw. fragmentów).
//    - AUTOMATYCZNIE INTERPOLUJE dane przekazywane z Vertex Shadera do Fragment Shadera!
//
// 3. FRAGMENT SHADER (Shader Fragmentów / Pikseli):
//    - Uruchamia się dla KAŻDEGO piksela widocznego na ekranie, który należy do danego trójkąta.
//    - Jego jedynym celem jest ustalenie ostatecznego koloru tego piksela (RGBA) w zmiennej wyjściowej `FragColor`.

// ----------------------------------------------------------------------------------------------
// SHADERY DLA SCENY 1 ORAZ SCENY 2
// ----------------------------------------------------------------------------------------------
// Pytanie z treści Zadania 1: "Czy uda się wykorzystać potok napisany do sceny 1 dla sceny 2?"
// ODPOWIEDŹ: TAK, dokładnie ten sam potok (program shaderów) obsługuje obie sceny!
//
// Dlaczego to działa?
// - Vertex shader przyjmuje atrybut aColor (kolor wierzchołka) i wysyła go dalej jako ourColor.
// - W SCENIE 1: Wszystkie 6 wierzchołków danego kwadratu dostaje z bufora identyczny kolor (np. czysty czerwony).
//   Gdy rasteryzator interpoluje wartości czerwony -> czerwony, wynik wszędzie wynosi czerwony (płaski kolor, brak gradientu).
// - W SCENIE 2: Każdy wierzchołek kwadratu dostaje inny losowy kolor (np. żółty, niebieski, zielony).
//   Rasteryzator płynnie miesza kolory między wierzchołkami, co daje automatyczny, sprzętowy GRADIENT!
const char* vertexShaderSource12 = R"(
#version 330 core
// Wersja GLSL 3.30 odpowiadająca OpenGL 3.3 Core Profile

// layout (location = 0): Slot 0 w VAO - współrzędne 2D wierzchołka (x, y)
layout (location = 0) in vec2 aPos;

// layout (location = 1): Slot 1 w VAO - kolor RGB wierzchołka z bufora pamięci GPU (r, g, b)
layout (location = 1) in vec3 aColor;

// Zmienna wyjściowa (out): przesyła kolor z tego shadera wprost do shadera fragmentów
out vec3 ourColor;

void main() {
    // gl_Position to wbudowana zmienna GLSL typu vec4 (x, y, z, w).
    // OpenGL operuje na współrzędnych jednorodnych (Homogeneous Coordinates):
    // aPos.x i aPos.y to nasza pozycja 2D na ekranie (w zakresie od -1.0 do +1.0),
    // 0.0 to głębokość Z (dla 2D nie ma znaczenia, więc dajemy 0),
    // 1.0 to współrzędna perspektywiczna W (dzielnik perspektywy; 1.0 oznacza brak zniekształcenia perspektywicznego).
    gl_Position = vec4(aPos, 0.0, 1.0);

    // Przekazujemy kolor dalej. Zanim trafi do fragment shadera, rasteryzator GPU
    // dokona interpolacji liniowej tego koloru na powierzchni trójkąta.
    ourColor = aColor;
}
)";

const char* fragmentShaderSource12 = R"(
#version 330 core

// Zmienna wejściowa (in) o tej samej nazwie i typie co 'out' w vertex shaderze.
// Otrzymuje zinterpolowany kolor fragmentu (piksela).
in vec3 ourColor;

// Zmienna wyjściowa: ostateczny kolor piksela w buforze ramki (RGBA)
out vec4 FragColor;

void main() {
    // Ustawiamy kolor fragmentu:
    // ourColor.r, ourColor.g, ourColor.b oraz 1.0 jako kanał Alpha (pełna nieprzezroczystość).
    FragColor = vec4(ourColor, 1.0);
}
)";

// ----------------------------------------------------------------------------------------------
// SHADERY DLA SCENY 3 (DOMEK Z BLENDERA)
// ----------------------------------------------------------------------------------------------
// Wymagania z Zadania 3 (grupa dzienna):
// 1. "Blender ma inny układ współrzędnych... domek będzie odwrócony... poeksperymentuj ze
//    współrzędnymi w vertex shaderze. Nie zmieniaj danych w pliku house.h".
// 2. "Aby kontrolować pozycję obiektu, prześlij zmienną jednorodną góra-dół i drugą prawo-lewo".
// 3. "W shaderze fragmentów skorzystaj z gl_PrimitiveID oraz gl_FragCoord aby nadać inne
//    kolory innym trójkątom. Koniecznie dodaj efekt przejścia gradientowego".
// 4. "W tej scenie, przeciwnie do poprzednich, to shader ma decydować o kolorach".

const char* vertexShaderSource3 = R"(
#version 330 core
layout (location = 0) in vec2 aPos;

// Dwie niezależne zmienne jednorodne (uniform):
// Zmienne 'uniform' to stałe parametry przekazywane z kodu C++ do GPU,
// które mają taką samą wartość dla wszystkich wierzchołków danego wywołania rysowania.
uniform float offsetX; // Kontrola pozycji poziomej (prawo-lewo, sterowane klawiszami A/D)
uniform float offsetY; // Kontrola pozycji pionowej   (góra-dół,   sterowane klawiszami W/S)

void main() {
    // ROZWIĄZANIE PROBLEMU UKŁADU WSPÓŁRZĘDNYCH BLENDERA:
    // W pliku house.h czubek dachu ma współrzędne (-0.65, 0.0), a podstawa ściany x = +0.25.
    // Oznacza to, że domek leży bokiem, a jego "góra" skierowana jest w lewo na osi X!
    // Aby go wyprostować i postawić pionowo dachem do góry bez ruszania house.h:
    // Dokonujemy rotacji o 90 stopni zgodnie z ruchem wskazówek zegara:
    // - nowa oś X przyjmuje starą wartość osi Y (aPos.y)
    // - nowa oś Y przyjmuje ujemną wartość starej osi X (-aPos.x)
    // Sprawdzenie: stary czubek dachu (-0.65, 0.0) -> nowy punkt (0.0, -(-0.65)) = (0.0, +0.65) -> IDEALNIE NA GÓRZE!
    vec2 rotatedPos = vec2(aPos.y, -aPos.x);

    // Na koniec dodajemy przesunięcie (offset) sterowane przez użytkownika z klawiatury
    gl_Position = vec4(rotatedPos.x + offsetX, rotatedPos.y + offsetY, 0.0, 1.0);
}
)";

const char* fragmentShaderSource3 = R"(
#version 330 core
out vec4 FragColor;

// Wbudowane zmienne środowiskowe języka GLSL:
// - gl_PrimitiveID: zawiera automatycznie nadawany przez GPU unikalny indeks trójkąta (0, 1, 2, ..., 8).
// - gl_FragCoord: zawiera bezwzględne współrzędne piksela w oknie (x w pikselach [0..800], y [0..600]).

void main() {
    // WYMÓG 1: Użycie gl_PrimitiveID do zróżnicowania kolorów trójkątów:
    // Chcemy, aby dach, komin, ściany i fundament miały różne, odcinające się kolory.
    // Używamy klasycznego algorytmu haszującego w GLSL opartego na funkcji sinus i fract():
    // sin(x) generuje pseudolosową falę, a fract(x) pobiera tylko część ułamkową (wartość [0.0, 1.0]).
    float id = float(gl_PrimitiveID);
    vec3 baseColor = vec3(
        fract(sin(id * 12.9898 + 1.0) * 43758.5453), // Składowa R dla danego trójkąta
        fract(sin(id * 78.2330 + 2.0) * 43758.5453), // Składowa G dla danego trójkąta
        fract(sin(id * 45.1640 + 3.0) * 43758.5453)  // Składowa B dla danego trójkąta
    );

    // WYMÓG 2: Użycie gl_FragCoord do stworzenia efektu przejścia gradientowego:
    // gl_FragCoord.y to pionowa pozycja fragmentu w oknie (od 0 na dole do 600 na górze okna).
    // Za pomocą funkcji sinus modulujemy jasność trójkątów, tworząc płynne cieniowanie w pionie.
    // Wartość sin waha się od -1 do 1, więc po pomnożeniu przez 0.25 i dodaniu 0.75 uzyskujemy zakres [0.5, 1.0].
    float vGradient = sin(gl_FragCoord.y * 0.02) * 0.25 + 0.75;

    // Dodatkowy gradient poziomy wzdłuż szerokości okna (800 pikseli):
    // Daje to delikatne przejście ciepłego światła od lewej do prawej strony okna.
    float hGradient = clamp(gl_FragCoord.x / 800.0, 0.0, 1.0);

    // Aplikacja gradientu pionowego na kolor bazowy trójkąta:
    vec3 shadedColor = baseColor * vGradient;

    // Zmiksowanie (funkcja mix to interpolacja liniowa lerp) z ciepłym kolorem pomarańczowym (1.0, 0.6, 0.2):
    vec3 finalColor = mix(shadedColor, vec3(1.0, 0.6, 0.2), hGradient * 0.3);

    // Ostateczne przypisanie koloru piksela (RGB + Alpha = 1.0)
    FragColor = vec4(finalColor, 1.0);
}
)";

